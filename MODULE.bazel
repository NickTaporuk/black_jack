module(
    name = "mersenne_twister",
    version = "0.1.0",
)

# Go rules
bazel_dep(name = "rules_go", version = "0.51.0")

# Gazelle (optional but recommended)
bazel_dep(name = "gazelle", version = "0.37.0")

# Platform constraints
bazel_dep(name = "platforms", version = "0.0.10")

# Enable Go rules
use_extension("@rules_go//go:extensions.bzl", "go")

# Enable Gazelle
use_extension("@gazelle//:extensions.bzl", "gazelle", dev_dependency = True)

# Activate generated repositories
use_repo("@rules_go__go_sdk")
use_repo("@bazel_gazelle__gazelle")
